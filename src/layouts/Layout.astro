---
import { SEO } from "astro-seo"
import "../styles/app.scss"

interface Props {
    title: string
    description: string
    og_title?: string
    og_type?: string
    og_image?: string
}

const {
    title,
    description,
    og_title = title,
    og_type = "website",
    og_image = "https://user-images.githubusercontent.com/5182256/131216951-8f74f425-f775-463d-a11b-0e01ad9fce8d.png",
} = Astro.props
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <SEO
            title={title + " | Masa HaChaim"}
            description={description}
            openGraph={{
                basic: {
                    title: og_title + " | Masa HaChaim",
                    type: og_type,
                    image: og_image,
                },
            }}
        />

        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>
