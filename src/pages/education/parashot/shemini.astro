---
import Layout from "@/layouts/Layout.astro"
---

<Layout
	title="Parashat Shemini"
	description="Educational resources for Parashat Shemini."
>
	<section class="pt-24 pb-32">
		<div class="px-6 flex justify-between items-start">
			<h1 class="mb-10">Parashat Shemini</h1>
			<div>
				<a href="/">Home</a> / <a href="/education"
					>Torah-Based Education</a
				>
			</div>
		</div>
		<div class="flex items-center pr-6">
			<hr class="border border-dark w-36" />
			<div class="w-3 h-3 bg-dark rounded-full"></div>
		</div>
	</section>

	<section class="bg-light border-y border-dark px-6 pb-12 mt-6">
		<div class="-mt-6 mb-10 flex justify-center">
			<div
				class="inline-block w-auto bg-light rounded-full border border-dark py-3 px-5 uppercase text-center font-semibold"
			>
				Writing Prompts
			</div>
		</div>
		<!-- <p class="eyebrow">Writing Prompts</p> -->
		<!-- <h2>Parashat Tzav</h2> -->
		<div class="grid grid-cols-3 gap-4">
			<div class="rounded-2xl p-6 bg-white">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					Donec lorem enim, consequat ac tortor sit amet, scelerisque?
				</p>
				<div class="flex gap-3">
					<span class="text-xs uppercase text-medium">Level 1</span>
					<span class="text-xs uppercase text-medium">Creative</span>
				</div>
			</div>
			<div class="rounded-2xl p-6 bg-white">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					Donec lorem enim, consequat ac tortor sit amet, scelerisque?
				</p>
				<div class="flex gap-3">
					<span class="text-xs uppercase text-medium">Level 2</span>
					<span class="text-xs uppercase text-medium">Research</span>
				</div>
			</div>
			<div class="rounded-2xl p-6 bg-white">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					Donec lorem enim, consequat ac tortor sit amet, scelerisque?
				</p>
				<div class="flex gap-3">
					<span class="text-xs uppercase text-medium">Level 3</span>
					<span class="text-xs uppercase text-medium">Persuasive</span
					>
				</div>
			</div>
		</div>
		<!-- <div class="flex justify-end mt-10">
			<a
				href="#!"
				class="button button--primary"
			>
				All Parashat Tzav
			</a>
		</div> -->
	</section>

	<section class="px-6 py-32 text-center">
		<p>More content coming soon!</p>
	</section>

	<section class="px-6 py-32 text-center">
		<a
			href="/education"
			class="button button--secondary"
			>View All Parashot</a
		>
	</section>

	<section class="py-32 bg-light rounded-t-2xl">
		<div class="mx-auto w-full max-w-md px-6">
			<h2 class="text-center mb-4">Get Updates</h2>
			<p class="text-center">
				We're always actively working to create more materials to
				support the Messianic community. Subscribe for resources and
				news about our latest projects!
			</p>
			<form class="space-y-2">
				<input
					type="text"
					name="name"
					placeholder="Name*"
					required
				/>
				<input
					type="email"
					name="email"
					placeholder="Email*"
					required
				/>
				<button
					type="submit"
					class="button button--primary w-full"
					>Subscribe</button
				>
			</form>
		</div>
	</section>
</Layout>
