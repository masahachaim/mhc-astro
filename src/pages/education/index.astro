			{ name: "Ki Tisa", status: "notcreated" },
			{ name: "Vayakhel", status: "notcreated" },
			{ name: "Pekudei", status: "notcreated" },
		],
	},
	{
		name: "Vayikra",
		parashot: [
			{ name: "Vayikra", status: "notcreated" },
			{ name: "Tzav", status: "notcreated" },
			{ name: "Shemini", status: "current", slug: "shemini" },
			{ name: "Tazria", status: "notcreated" },
			{ name: "Metzora", status: "notcreated" },
			{ name: "Achrei Mot", status: "notcreated" },
			{ name: "Kedoshim", status: "notcreated" },
			{ name: "Emor", status: "notcreated" },
			{ name: "Behar", status: "notcreated" },
			{ name: "Bechukotai", status: "notcreated" },
		],
	},
	{
		name: "Bamidbar",
		parashot: [
			{ name: "Bamidbar", status: "notcreated" },
			{ name: "Nasso", status: "notcreated" },
			{ name: "Beha'alotecha", status: "notcreated" },
			{ name: "Shelach", status: "notcreated" },
			{ name: "Korach", status: "notcreated" },
			{ name: "Chukat", status: "notcreated" },
			{ name: "Balak", status: "notcreated" },
			{ name: "Pinchas", status: "notcreated" },
			{ name: "Matot", status: "notcreated" },
			{ name: "Masei", status: "notcreated" },
		],
	},
	{
		name: "Devarim",
		parashot: [
			{ name: "Devarim", status: "notcreated" },
			{ name: "Vaetchanan", status: "notcreated" },
			{ name: "Eikev", status: "notcreated" },
			{ name: "Re'eh", status: "notcreated" },
			{ name: "Shoftim", status: "notcreated" },
			{ name: "Ki Teitzei", status: "notcreated" },
			{ name: "Ki Tavo", status: "notcreated" },
			{ name: "Nitzavim", status: "notcreated" },
			{ name: "Vayelech", status: "notcreated" },
			{ name: "Ha'azinu", status: "notcreated" },
			{ name: "Vezot Haberakhah", status: "notcreated" },
		],
	},
]
---

<Layout
	title="Torah-Based Education"
	description="Educational resources based on the Torah for Messianic families, homeschoolers, and communities."
>
	<section class="pt-24 pb-32">
		<div class="px-6"><h1 class="mb-10">Torah-Based Education</h1></div>
		<div class="flex items-center pr-6">
			<hr class="border border-dark w-36" />
			<div class="w-3 h-3 bg-dark rounded-full"></div>
		</div>
	</section>

	<section class="bg-light border-y border-dark px-6 pb-12 mt-6">
		<div class="-mt-6 mb-10 flex justify-center">
			<div
				class="inline-block w-auto bg-light rounded-full border border-dark py-3 px-5 uppercase text-center font-semibold"
			>
				This Week's Writing Prompts
			</div>
		</div>
		<!-- <p class="eyebrow">Writing Prompts</p> -->
		<h2>Parashat Tzav</h2>
		<div class="grid grid-cols-3 gap-4">
			<div class="rounded-2xl p-6 bg-white">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					Donec lorem enim, consequat ac tortor sit amet, scelerisque?
				</p>
				<div class="flex gap-3">
					<span class="text-xs uppercase text-medium">Level 1</span>
					<span class="text-xs uppercase text-medium">Creative</span>
				</div>
			</div>
			<div class="rounded-2xl p-6 bg-white">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					Donec lorem enim, consequat ac tortor sit amet, scelerisque?
				</p>
				<div class="flex gap-3">
					<span class="text-xs uppercase text-medium">Level 2</span>
					<span class="text-xs uppercase text-medium">Research</span>
				</div>
			</div>
			<div class="rounded-2xl p-6 bg-white">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					Donec lorem enim, consequat ac tortor sit amet, scelerisque?
				</p>
				<div class="flex gap-3">
					<span class="text-xs uppercase text-medium">Level 3</span>
					<span class="text-xs uppercase text-medium">Persuasive</span
					>
				</div>
			</div>
		</div>
		<!-- <div class="flex justify-end mt-10">
			<a
				href="#!"
				class="button button--primary"
			>
				All Parashat Tzav
			</a>
		</div> -->
	</section>

	<section class="px-6 py-32">
		<h2>All Parashot</h2>
		<div class="grid grid-cols-5 gap-4 text-center">
			{
				books.map((book) => (
					<div class="border border-medium rounded-2xl overflow-hidden">
						<h3 class="mb-0 text-sm uppercase text-white rounded-2xl py-3 px-5 bg-medium">
							{book.name}
						</h3>
						{book.parashot.map((parasha) => (
							<a
								href={
									parasha.slug
										? `/education/parashot/${parasha.slug}`
										: "#!"
								}
								class={`no-underline py-2 font-semibold hover:bg-light block ${
									parasha.status === "notcreated"
										? "text-medium cursor-not-allowed hover:bg-white"
										: parasha.status === "current"
											? "bg-medlight hover:bg-medlight"
											: ""
								} `}
							>
								{parasha.name}
							</a>
						))}
					</div>
				))
			}
		</div>
	</section>

	<section class="py-32 bg-light rounded-t-2xl">
		<SubscribeForm client:load />
	</section>
</Layout>
