---
import SubscribeForm from "@/components/SubscribeForm"
import Layout from "@/layouts/Layout.astro"

const books = [
	{
		name: "Bereishit",
		parashot: [
			{ name: "Bereishit", status: "notcreated" },
			{ name: "Noach", status: "notcreated" },
			{ name: "Lech-Lecha", status: "notcreated" },
			{ name: "Vayera", status: "notcreated" },
			{ name: "Chayei Sarah", status: "notcreated" },
			{ name: "Toldot", status: "notcreated" },
			{ name: "Vayetzei", status: "notcreated" },
			{ name: "Vayishlach", status: "notcreated" },
			{ name: "Vayeshev", status: "notcreated" },
			{ name: "Miketz", status: "notcreated" },
			{ name: "Vayigash", status: "notcreated" },
			{ name: "Vayechi", status: "notcreated" },
		],
	},
	{
		name: "Shemot",
		parashot: [
			{ name: "Shemot", status: "notcreated" },
			{ name: "Va'era", status: "notcreated" },
			{ name: "Bo", status: "notcreated" },
			{ name: "Beshalach", status: "notcreated" },
			{ name: "Yitro", status: "notcreated" },
			{ name: "Mishpatim", status: "notcreated" },
			{ name: "Terumah", status: "notcreated" },
