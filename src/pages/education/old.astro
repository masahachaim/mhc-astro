---
import Layout from "../../layouts/Layout.astro"
import Button from "../../components/Button.astro"
import ButtonDisabled from "../../components/ButtonDisabled.astro"
import CTA from "../../components/CTA.astro"
---

<Layout
    title="Education"
    description="Messianic education - passing on the torch to the next generation"
>
    <section class="hero">
        <div class="w-2/3">
            <h1>Passing on the torch</h1>
            <p>
                <em>Page under construction. Thank you for your patience!</em>
            </p>
        </div>
        <div class="w-1/3">
            <img
                class="img-tall"
                src="https://cdn.pixabay.com/photo/2012/12/21/16/42/lighter-71790_1280.jpg"
            />
        </div>
    </section>

    <div class="separator">Programs</div>

    <section>
        <div class="columns-3">
            <div>
                <h3>Memory Club</h3>
                <p class="mb-6">
                    Encouraging believers to memorize Scripture and learn from
                    it. Choose from different topics, or pick a whole book of
                    the Bible.
                </p>
                <ButtonDisabled text="Coming Soon" />
            </div>
            <div>
                <h3>Bible Reading Challenge</h3>
                <p class="mb-6">
                    Resources to help you read through the entire Bible once, at
                    your own pace. If you've done it before, challenge yourself
                    with our four-month reading plan.
                </p>
                <ButtonDisabled text="Coming Soon" />
            </div>
            <div>
                <h3>Torah-Integrated Learning</h3>
                <p class="mb-6">
                    Activities that bring Torah portions to life, integrated
                    into homeschooling curriculum.
                </p>
                <ButtonDisabled text="Coming Soon" />
            </div>
        </div>
    </section>

    <section class="dark page-section">
        <h2>Messianic 101</h2>
        <p>Introduction to Messianic Judaism and apologetics. Coming soon!</p>
    </section>

    <section>
        <CTA>
            <h2>Pinguni</h2>
            <p>
                The ultimate guide to online homeschooling resources. For all
                ages and subjects.
            </p>
            <Button href="https://pinguni.org" text="Visit Pinguni" />
        </CTA>
    </section>

