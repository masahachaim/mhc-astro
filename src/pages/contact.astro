---
import Layout from "@/layouts/Layout.astro"
---

<Layout
	title="Contact"
	description="Get in touch with us."
	footer_bg="bg-white"
>
	<section
		class="px-6 pt-16 pb-24 sm:pt-24 sm:pb-32 max-w-5xl mx-auto text-center"
	>
		<h1 class="mb-5">Contact</h1>
		<p>
			Got a question, suggestion, or concern? Feel free to send us an
			email at <a
				href="mailto:contact@masahachaim.org"
				class="underline"
				>contact@masahachaim.org</a
			>, or use the form below.
		</p>
