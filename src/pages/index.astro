	<section class="relative">
		<div class="h-120 w-7/12 rounded-r-2xl overflow-hidden">
			<img
				src="https://cdn.pixabay.com/photo/2020/06/17/17/01/plant-5310423_1280.jpg"
				class="object-cover w-full h-full"
			/>
		</div>
		<div
			class="bg-light absolute top-1/2 -translate-y-1/2 right-0 w-7/12 rounded-l-2xl p-12"
		>
			<div>
				<h2>What is Masa HaChaim?</h2>
				<p>
					<em>Masa haChaim</em> is a Hebrew phrase that means "journey of
					life", referring to the never-ending process of growing in our
					faith.
				</p>
				<p>
					We're committed to building a strong and vibrant Messianic
					community for the next generation. We seek to provide
					resources that encourage and strengthen families,
					congregations, children, youth, and more.
				</p>
			</div>
		</div>
	</section>

	<section class="px-6 py-32">
		<h2>Supporting Our...</h2>
		<div class="grid grid-cols-4 gap-4">
			{
				supports.map((sup) => (
					<div class="rounded-2xl border border-dark flex flex-col items-center p-12">
						<Icon
							name={sup.icon}
							class="text-6xl mb-3"
						/>
						<h3 class="mb-0">{sup.title}</h3>
					</div>
				))
			}
		</div>
	</section>

	<section class="bg-light border-y border-dark px-6 pb-12 mt-6">
		<div class="-mt-6 mb-10 flex justify-center">
