---
import SubscribeForm from "@/components/SubscribeForm"
import Layout from "@/layouts/Layout.astro"
import { Icon } from "astro-icon/components"

const supports = [
	{
		title: "Youth",
		icon: "material-symbols:child-hat-rounded",
	},
	{
		title: "Young Adults",
		icon: "material-symbols:person-raised-hand-rounded",
	},
	{
		title: "Families",
		icon: "material-symbols:family-restroom-rounded",
	},
	{
		title: "Communities",
		icon: "material-symbols:synagogue-rounded",
	},
]

const products = [
	{
		title: "Messianic Planner 2026 (5786-5787, January-December)",
		description:
			"A beautiful, minimal 12-month Messianic planner to help you stay organized and focused on the Word.",
		image: "planner.webp",
		href: "https://masahachaim.etsy.com/listing/4367945847",
	},
	{
		title: "Im Eshkachech Yerushalyaim (Psalm 137:5) Bookmark",
		description: `Featuring Psalm 137:5 in Hebrew and English: "If I forget thee, O Jerusalem, let my right hand forget her cunning."`,
		image: "bookmark.webp",
		href: "https://masahachaim.etsy.com/listing/4367947956",
	},
]
