				</div>
			</div>
		</div>
		<div class="flex justify-end mt-10">
			<a
				href="#!"
				class="button button--primary"
			>
				View All Parashot
			</a>
		</div>
	</section>

	<section
		class="py-24 sm:py-32"
		id="get-updates"
	>
		<SubscribeForm client:load />
	</section>

