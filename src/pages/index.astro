---
import Layout from "../layouts/Layout.astro"
import Button from "../components/Button.astro"
import CTA from "../components/CTA.astro"
---

<Layout
    title="Home"
    description="Building a Messianic legacy for our families and the next generation"
>
    <section class="hero">
        <div class="w-2/3">
            <h1>Building a Messianic legacy for the next generation</h1>
            <Button text="Mission & Vision" href="/about" target="_self" />
        </div>
        <div class="w-1/3">
            <img
                src="https://mhcdirectus.server.createfulpurpose.com/assets/8c0ace7f-5b52-4d65-baf5-17060423fc2a"
            />
        </div>
    </section>

    <div class="sections">
        <section>
            <CTA>
                <h2>What is Masa HaChaim?</h2>
                <p>
                    <em>Masa haChaim</em> is a Hebrew phrase that means "journey
                    of life".
                </p>
            </CTA>
        </section>
        <section>
            <h2>Integrating values and beliefs into everyday life</h2>
            <div class="columns-3 text-lg">
                <div>
                    <p>
                        <span
                            >Lorem ipsum dolor sit amet, consectetur adipiscing
                            elit, sed do eiusmod tempor incididunt ut labore et
                            dolore magna aliqua.</span
                        >
                    </p>
                </div>
                <div>
                    <p>
                        <span
                            >Ut enim ad minim veniam, quis nostrud exercitation
                            ullamco laboris nisi ut aliquip ex ea commodo
                            consequat.</span
                        >
                    </p>
                </div>
                <div>
                    <p>
                        <span
                            >Excepteur sint occaecat cupidatat non proident,
                            sunt in culpa qui officia deserunt mollit anim id
                            est laborum.</span
                        >
                    </p>
                </div>
            </div>
        </section>
        <section>
            <CTA>
                <h2>HaDor HaBa</h2>
                <p>Website for Messianic youth.</p>
                <Button text="Visit Here" href="https://hdhb.masahachaim.org" />
            </CTA>
        </section>
    </div>
</Layout>
