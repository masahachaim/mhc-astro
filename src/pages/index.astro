					<a
						href={product.href}
						target="_blank"
						class="relative block no-underline bg-white rounded-2xl overflow-hidden shadow-lg duration-300 hover:shadow-xl"
					>
						<img
							src={product.image}
							class="w-full object-cover h-96"
						/>
						<div class="p-6">
							<h3>{product.title}</h3>
							<p>{product.description}</p>
							<p class="uppercase font-semibold mb-0 flex gap-1">
